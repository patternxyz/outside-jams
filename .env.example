NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ol-jams
DB_SSL=false
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
API_RATE_LIMIT=100
API_RATE_LIMIT_TTL_MS=60000
API_BASE_URL=
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_TASKS_QUEUE=spotify-sync
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
CLOUD_TASKS_AUDIENCE=
TRUST_PROXY=false
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOKEN_CACHE_SIZE=500
SPOTIFY_TOKEN_CACHE_TTL_MS=300000
