NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ol-jams
DB_SSL=false
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
API_RATE_LIMIT=100
API_RATE_LIMIT_TTL_MS=60000
API_BASE_URL=
GCP_PROJECT_ID=outside-jams
GCP_REGION=us-central1
CLOUD_TASKS_QUEUE=spotify-sync
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
CLOUD_TASKS_AUDIENCE=
TRUST_PROXY=false
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
SPOTIFY_REQUEST_INTERVAL_MS=1000
SPOTIFY_ALBUM_PAGE_LIMIT=1
SPOTIFY_RESUME=true
SPOTIFY_TOKEN_CACHE_SIZE=500
SPOTIFY_TOKEN_CACHE_TTL_MS=300000

# GitHub Actions deployment variables only; the application does not read these.
# Configure them in the GitHub `dev` environment, not in the runtime environment.
# ARTIFACT_REGISTRY_REPOSITORY=gcr-outside-jams
# CLOUD_RUN_SERVICE=svc-outside-jams
# CLOUD_RUN_SERVICE_ACCOUNT_EMAIL=outside-jams-runtime@your-project.iam.gserviceaccount.com
# GCP_WIF_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
# GCP_WIF_SERVICE_ACCOUNT=github-actions-deployer@your-project.iam.gserviceaccount.com
